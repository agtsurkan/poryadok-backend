# ─── Порядок backend · example environment ───────────────────────────────────
# Copy to `.env` and adjust. Never commit the real `.env`.

# Database. Production = PostgreSQL (async driver). For a zero-setup first local
# run you may use SQLite, but Postgres is the target — see README.
DATABASE_URL=postgresql+asyncpg://poryadok:poryadok@localhost:5432/poryadok
# DATABASE_URL=sqlite+aiosqlite:///./poryadok.db

# Auth (P0 = a single hard-coded user, seeded from these values).
AUTH_EMAIL=demo@poryadok.app
AUTH_PASSWORD=poryadok
# Generate a long random secret (>= 32 bytes), e.g.  openssl rand -hex 32
JWT_SECRET=change-me-please-generate-a-long-random-secret-32b-or-more
JWT_EXPIRE_DAYS=30

# CORS — the standalone frontend calls the API from the browser.
# Comma-separated origins, or "*" for local development.
CORS_ORIGINS=*

# Client-cooling thresholds (used by P1; harmless to set now).
COOLING_WARM_DAYS=7
COOLING_COLD_DAYS=21

# ─── Telegram + Claude capture (P2) — leave empty until you wire the bot ──────
ANTHROPIC_API_KEY=        # Claude, for intent routing
OPENAI_API_KEY=           # Whisper, for voice transcription
TELEGRAM_BOT_TOKEN=       # from @BotFather; presence enables /telegram/webhook
TELEGRAM_ALLOWED_USER_IDS= # comma-separated Telegram user ids (whitelist)
TELEGRAM_WEBHOOK_SECRET=  # set the same value when calling setWebhook
ROUTER_MODEL=claude-sonnet-4-6
WHISPER_MODEL=whisper-1
